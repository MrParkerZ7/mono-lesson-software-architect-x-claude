        </mxCell>
        <mxCell id="topic3-content" value="&lt;b&gt;SOLID&lt;/b&gt; - 5 OOP principles&lt;br&gt;&lt;b&gt;DRY&lt;/b&gt; - Don't Repeat Yourself&lt;br&gt;&lt;b&gt;KISS&lt;/b&gt; - Keep It Simple&lt;br&gt;&lt;b&gt;YAGNI&lt;/b&gt; - You Aren't Gonna Need It&lt;br&gt;&lt;b&gt;Separation of Concerns&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#c2185b;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="610" y="145" width="220" height="145" as="geometry" />
        </mxCell>

        <!-- Topic 4: API Design -->
