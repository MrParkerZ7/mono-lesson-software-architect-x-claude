        <mxCell id="topic3-title" value="&lt;b&gt;03 - ARCHITECTURE PRINCIPLES&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=#c2185b;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;fontColor=#ffffff;" vertex="1" parent="1">
